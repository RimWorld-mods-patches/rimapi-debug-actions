<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RimApiDebugActions</AssemblyName>
    <RootNamespace>RimApiDebugActions</RootNamespace>
    <Version>0.3.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <OutputPath>../../1.7/Assemblies/</OutputPath>
  </PropertyGroup>

  <!-- RIMAPI is not on NuGet. Its 1.10.0 release carries its API assemblies
       under 1.6/Assemblies; the API contract is used to build this 1.7 mod.
       The build verifies the archive hash and references assemblies from obj/.
       Nothing from RIMAPI is copied into this mod. -->
  <PropertyGroup>
    <RimApiVersion>1.10.0</RimApiVersion>
    <RimApiSha256>4c07cd4f23cb88287c86a0159f11e9e935b22b7d460f4675a19191136e479dc9</RimApiSha256>
    <RimApiArchiveUrl>https://github.com/IlyaChichkov/RIMAPI/releases/download/v$(RimApiVersion)/RIMAPI-$(RimApiVersion).zip</RimApiArchiveUrl>
    <RimApiCache>$(MSBuildProjectDirectory)/obj/rimapi/$(RimApiVersion)</RimApiCache>
    <RimApiDirectory>$(RimApiCache)/1.6/Assemblies</RimApiDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4990-unstable" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="RIMAPI">
      <HintPath>$(RimApiDirectory)/RIMAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RimApiDirectory)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="FetchRimApi" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(RimApiDirectory)/RIMAPI.dll')">
    <DownloadFile SourceUrl="$(RimApiArchiveUrl)" DestinationFolder="$(RimApiCache)" Retries="3">
      <Output TaskParameter="DownloadedFile" PropertyName="_RimApiArchive" />
    </DownloadFile>
    <GetFileHash Files="$(_RimApiArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_RimApiArchiveHash" />
    </GetFileHash>
    <Delete Files="$(_RimApiArchive)" Condition="'$(_RimApiArchiveHash)' != '$(RimApiSha256)'" />
    <Error Condition="'$(_RimApiArchiveHash)' != '$(RimApiSha256)'"
           Text="RIMAPI $(RimApiVersion) archive hash $(_RimApiArchiveHash) does not match the pinned $(RimApiSha256)." />
    <Unzip SourceFiles="$(_RimApiArchive)" DestinationFolder="$(RimApiCache)" />
    <Error Condition="!Exists('$(RimApiDirectory)/RIMAPI.dll') Or !Exists('$(RimApiDirectory)/Newtonsoft.Json.dll')"
           Text="RIMAPI $(RimApiVersion) archive has no 1.6/Assemblies/RIMAPI.dll and Newtonsoft.Json.dll." />
  </Target>
</Project>
